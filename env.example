# Copy to .env and fill in real values. NEVER commit .env.
# Avoid the "$" character in passwords (Compose treats it as variable interpolation).

# --- General ---
TZ=Europe/Warsaw
PUID=1000
PGID=1000
# Address that published ports bind to. 0.0.0.0 = all interfaces (default).
# Set to the LAN IP of the Docker host to keep ports off other interfaces
# (this also makes them unreachable via the Tailscale IP of this host).
BIND_IP=192.168.100.110

# --- Cloudflare Tunnel (token from the Cloudflare Zero Trust dashboard) ---
CLOUDFLARE_TUNNEL_TOKEN=changeme

# --- Immich (hostnames for Postgres/Redis are set in docker-compose.yml) ---
DB_USERNAME=immich
DB_PASSWORD=changeme
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./immich/postgres
# Optional: only if your Postgres uses pgvector instead of VectorChord
# DB_VECTOR_EXTENSION=pgvector

# --- Pi-hole ---
PIHOLE_PASSWORD=changeme

# --- Home Assistant (Zigbee dongle path on the Docker host) ---
HA_USB_DEVICE=/dev/serial/by-id/usb-REPLACE_WITH_YOUR_DONGLE

# --- Homarr (generate with: openssl rand -hex 32) ---
HOMARR_KEY=changeme

# --- Mounted directories ---
FILEBROWSER_MOUNT_DIR=/mnt
GLANCES_MOUNT_DIR=/mnt

# --- Gluetun / ProtonVPN (WireGuard private key from your Proton account,
#     created with NAT-PMP / port forwarding enabled) ---
PROTONVPN_PRIVATE_KEY=changeme
# LAN + Tailscale nodes allowed to bypass the VPN (comma-separated CIDRs)
FIREWALL_OUTBOUND_SUBNETS=100.64.0.1/32,100.64.0.2/32,192.168.100.0/24

# --- Samba (login user is "samba") ---
SAMBA_PASSWORD=changeme

# --- Optional: pin image versions (defaults: latest / stable / release) ---
# IMMICH_VERSION=release
# HA_VERSION=stable
# PIHOLE_VERSION=latest
# NPM_VERSION=latest
# HOMARR_VERSION=latest
# GLUETUN_VERSION=latest
# QBITTORRENT_VERSION=latest
# UPTIME_KUMA_VERSION=latest
# CLOUDFLARED_VERSION=latest
# GLANCES_VERSION=latest
# FILEBROWSER_VERSION=latest
# HOMARR_IFRAMES_VERSION=latest
# SAMBA_VERSION=latest
# SOCKET_PROXY_VERSION=latest
