# Copy to .env and fill in real values. NEVER commit .env.
# Avoid the "$" character in passwords (Compose treats it as variable interpolation).

# --- General ---
TZ=Europe/Warsaw
PUID=1000
PGID=1000
# LAN address of the Docker host (NPM admin UI binds here; defaults to 127.0.0.1 if unset)
LAN_IP=192.168.100.110

# Compose profiles: "custom" enables the local `kindle` and `rss` services (need ./kindle and ./rss).
# Leave empty if you do not have them.
COMPOSE_PROFILES=

# --- Cloudflare Tunnel (token from the Cloudflare Zero Trust dashboard) ---
CLOUDFLARE_TUNNEL_TOKEN=changeme

# --- Immich (used by Postgres and immich-server; Postgres/Redis hostnames are set in the compose file) ---
DB_USERNAME=immich
DB_PASSWORD=changeme
DB_DATABASE_NAME=immich
DB_DATA_LOCATION=./immich/postgres

# --- Pi-hole ---
PIHOLE_PASSWORD=changeme

# --- Home Assistant (Zigbee dongle path on the Docker host) ---
HA_USB_DEVICE=/dev/serial/by-id/usb-REPLACE_WITH_YOUR_DONGLE

# --- Homarr (generate with: openssl rand -hex 32) ---
HOMARR_KEY=changeme

# --- Mounted directories ---
FILEBROWSER_MOUNT_DIR=/mnt
GLANCES_MOUNT_DIR=/mnt

# --- RSS service (profile "custom") ---
GEMINI_API_KEY=changeme

# --- Gluetun / ProtonVPN (WireGuard key created with NAT-PMP / port forwarding enabled) ---
PROTONVPN_PRIVATE_KEY=changeme
# LAN + Tailscale nodes allowed to bypass the VPN (comma-separated CIDRs)
FIREWALL_OUTBOUND_SUBNETS=100.64.0.1/32,100.64.0.2/32,192.168.100.0/24

# --- Samba (dperson/samba format: user;password) ---
SAMBA_USER=user;changeme
